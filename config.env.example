# Copy to config.env (gitignored) for local development: `cp config.env.example config.env`
# Deployed environments set these in the hosting provider instead.

PORT=3000
NODE_ENV=development

# MongoDB connection string; <PASSWORD> is replaced with DATABASE_PASSWORD
DATABASE=mongodb+srv://<user>:<PASSWORD>@<cluster>.mongodb.net/<database>
DATABASE_PASSWORD=

# Signs the API tokens. Use a long random string and never reuse it between environments.
JWT_SECRET=
JWT_EXPIRES_IN=90d

# Product images: uploaded by the dashboard straight to this Cloudinary account
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe card payments (test keys work; the webhook secret comes from the endpoint's settings)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Comma-separated browser origins allowed by CORS.
# Defaults to local development plus the deployed dashboard and storefront.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3001
